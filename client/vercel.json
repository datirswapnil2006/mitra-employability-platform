{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://api.mitraemployabilityportal.in/api/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://api.mitraemployabilityportal.in/uploads/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
