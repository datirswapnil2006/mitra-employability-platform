PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key
GEMINI_API_KEY=your_gemini_api_key
Groq_API_KEY=your_groq_api_key
HuggingFace_API_KEY=your_huggingface_api_key

# -------------------------------------------------------------
# MAILTRAP SMTP CONFIGURATION (Configured in Render Environment)
# -------------------------------------------------------------
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_mailtrap_smtp_user
MAIL_PASSWORD=your_mailtrap_smtp_password
# EMAIL_FROM must use a sender domain authorized in your Mailtrap account (e.g. hello@demomailtrap.com for testing, or your verified domain)
EMAIL_FROM="MITRA Employability Portal <hello@demomailtrap.com>"
FRONTEND_URL=https://your-mitra-frontend.vercel.app

