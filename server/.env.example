PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key
ACCESS_TOKEN_EXPIRY=24h
# 24 hours inactivity timeout in milliseconds (86400000)
INACTIVITY_TIMEOUT_MS=86400000
GEMINI_API_KEY=your_gemini_api_key
Groq_API_KEY=your_groq_api_key
HuggingFace_API_KEY=your_huggingface_api_key

# -------------------------------------------------------------
# HOSTINGER / CUSTOM DOMAIN SMTP (Recommended for Render)
# -------------------------------------------------------------
MAIL_HOST=smtp.hostinger.com
# Port 465 (SSL) or Port 587 (TLS/STARTTLS)
MAIL_PORT=465
# Your full business email address on your custom domain
MAIL_USER=contact@mitraemployabilityportal.in
# Your mailbox password for this email
MAIL_PASSWORD=your_mailbox_password
# Sender header format
EMAIL_FROM="MITRA Employability Portal <contact@mitraemployabilityportal.in>"
# Production frontend URL
FRONTEND_URL=https://mitra-employability-platform.vercel.app
